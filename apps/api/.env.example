# Copy to .env and fill in. The app refuses to boot if any of these are missing
# or malformed — see src/config/env.validation.ts.

NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string, or mongodb://localhost:27017/task-management
MONGODB_URI=mongodb://localhost:27017/task-management

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000
