{
  "name": "task-management",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev --workspace @tms/api",
    "dev:web": "npm run dev --workspace @tms/web",
    "build": "npm run build:shared && npm run build --workspace @tms/api && npm run build --workspace @tms/web",
    "typecheck": "npm run build:shared && npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspace @tms/api",
    "build:shared": "npm run build --workspace @tms/shared",
    "postinstall": "npm run build:shared"
  }
}
